{
  "name": "next-sanity-unknown-foundation",
  "private": true,
  "engines": {
    "node": ">=22.20 <23"
  },
  "scripts": {
    "predev": "npm run typegen",
    "dev": "next dev --webpack",
    "prebuild": "npm run typegen",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:production": "node tests/production.mjs",
    "setup": "sanity init --env .env.local --no-nextjs-add-config-files",
    "webhook": "node scripts/webhook.mjs",
    "webhook:apply": "sanity exec scripts/webhook.mjs --with-user-token -- --apply",
    "typegen": "sanity schema extract --force && sanity typegen generate"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "@sanity/client": "8.15.0",
    "@sanity/icons": "^3.7.4",
    "@sanity/image-url": "^2.0.3",
    "@sanity/preview-url-secret": "4.1.5",
    "@sanity/vision": "6.22.0",
    "@sanity/webhook": "^4.0.4",
    "@tailwindcss/postcss": "4.3.5",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vercel/functions": "3.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "groq": "6.22.0",
    "lucide-react": "^0.563.0",
    "next": "16.4.5",
    "next-plausible": "^3.12.5",
    "next-sanity": "13.4.0",
    "postcss": "^8.5.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanity": "6.22.0",
    "schema-dts": "^1.1.5",
    "server-only": "^0.0.1",
    "styled-components": "^6.3.8",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "4.3.5",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "eslint": "^9.39.2",
    "eslint-config-next": "16.4.5",
    "groq-js": "^1.23.0",
    "playwright": "1.65.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
